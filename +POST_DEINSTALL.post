#!/bin/sh
set -eu

rm -f /etc/newsyslog.conf.d/clientcontrol \
    /var/run/clientcontrol-uninstalling \
    /var/run/clientcontrol-schedule.json \
    /var/run/clientcontrol-schedule.lock \
    /usr/local/opnsense/mvc/app/cache/*volgodon_clientcontrol*.volt.php
configctl filter reload >/dev/null 2>&1 || :
configctl cron restart >/dev/null 2>&1 || :
