#!/bin/sh
set -eu
rm -f /var/run/clientcontrol-uninstalling

AUDIT_DIR=/var/log/clientcontrol
AUDIT_FILE=$AUDIT_DIR/audit.log
if [ -L "$AUDIT_DIR" ] || [ -L "$AUDIT_FILE" ]; then
    echo 'refusing to use a symbolic-link Client Control audit path' >&2
    exit 1
fi
if pw usershow wwwonly >/dev/null 2>&1; then
    AUDIT_OWNER=wwwonly
else
    AUDIT_OWNER=www
fi
install -d -o root -g wheel -m 0751 "$AUDIT_DIR"
if [ ! -e "$AUDIT_FILE" ]; then
    install -o "$AUDIT_OWNER" -g wheel -m 0640 /dev/null "$AUDIT_FILE"
else
    chown "$AUDIT_OWNER":wheel "$AUDIT_FILE"
    chmod 0640 "$AUDIT_FILE"
fi

# Installation is intentionally non-invasive. The model defaults to disabled
# and preview-only; administrators must review and apply an exact plan in UI.
configctl template reload OPNsense/Menu >/dev/null 2>&1 || :
# Package upgrades run deinstall hooks first; rebuild the filter after the new hook is back on disk.
configctl filter reload >/dev/null 2>&1 || :
configctl cron restart >/dev/null 2>&1 || :
# Volt templates are recompiled on demand; clear every Client Control view without restarting the web GUI.
rm -f /usr/local/opnsense/mvc/app/cache/*volgodon_clientcontrol*.volt.php
